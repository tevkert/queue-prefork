{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tevkert/queue-prefork-workbench",
    "type": "project",
    "description": "Laravel 13 workbench app for tevkert/queue-prefork: a production-sized dependency set, Horizon with six supervisors, fixture jobs and a soak job mix. Runs inside docker/ only.",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true,
                "versions": {
                    "tevkert/queue-prefork": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "aws/aws-sdk-php": "^3.390",
        "bepsvpt/blurhash": "^4.1",
        "cviebrock/eloquent-sluggable": "^13.0",
        "filament/filament": "^5.7",
        "geoip2/geoip2": "^3.4",
        "guzzlehttp/guzzle": "^7.9",
        "imangazaliev/didom": "^2.0",
        "intervention/image": "^4.2",
        "itsgoingd/clockwork": "^5.3",
        "laminas/laminas-feed": "^2.26",
        "laravel/ai": "^0.10.2",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.17",
        "laravel/horizon": "5.50.*",
        "laravel/nightwatch": "^1.28",
        "laravel/octane": "^2.18",
        "laravel/pennant": "^1.24",
        "laravel/pulse": "^1.8",
        "laravel/scout": "^11.4",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-ftp": "^3.31",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.15",
        "livewire/livewire": "^4.2",
        "maxmind-db/reader": "^1.14",
        "mews/purifier": "^3.4",
        "minishlink/web-push": "^8.0",
        "opcodesio/log-viewer": "^3.24",
        "platformcommunity/flysystem-bunnycdn": "^3.3",
        "ramsey/uuid": "^4.9",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/manager": "^4.9",
        "socialiteproviders/twitch": "^5.4",
        "spatie/fork": "^1.2",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-sitemap": "^7.4",
        "spatie/laravel-sluggable": "^4.0",
        "spatie/schema-org": "^3.23",
        "spatie/valuestore": "^1.3",
        "symfony/html-sanitizer": "^7.3|^8.0",
        "tevkert/queue-prefork": "@dev",
        "typesense/typesense-php": "^6.0",
        "webklex/php-imap": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/autoload-pid.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --no-ansi",
            "@php artisan filament:upgrade"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
