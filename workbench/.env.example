# The workbench runs only inside docker/ (see docker/README.md). docker/compose.yml sets every
# variable below per container (real environment variables win over a .env file), so no .env is
# needed. Shown here for reference, with app-stock's values.

APP_NAME=workbench
APP_ENV=prefork-test          # never `testing`: Laravel skips console events under it
APP_KEY=                      # fixed test key in docker/compose.yml
APP_DEBUG=false

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hp_stock          # hp_prefork in app-prefork
DB_USERNAME=hp
DB_PASSWORD=hp

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
CACHE_STORE=redis
SESSION_DRIVER=array

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0                    # 2 in app-prefork
REDIS_CACHE_DB=1              # 3 in app-prefork
REDIS_PREFIX=hp_stock:
CACHE_PREFIX=hp_stock_cache:
HORIZON_PREFIX=hp_stock_horizon:

QUEUE_PREFORK=false           # true in app-prefork
HORIZON_FAST_TERMINATION=true
HORIZON_TIMEOUT=150           # worker timeout of every supervisor but notify (60)

WORKBENCH_STUB_URL=http://stub:8080
WORKBENCH_TRACE=true

# The package set, offline (docker/compose.yml): every endpoint is the stub.
APP_URL=http://workbench.test
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail         # storage/logs/mail-*.log, one day kept
NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=workbench-dummy-token   # no agent: every ingest is refused and dropped
PULSE_ENABLED=true            # database storage
SCOUT_DRIVER=database
SCOUT_QUEUE_ENABLED=true      # index jobs on the `scout` queue
OPENROUTER_API_KEY=workbench-dummy-key
OPENROUTER_URL=http://stub:8080/v1
AWS_ACCESS_KEY_ID=workbench
AWS_SECRET_ACCESS_KEY=workbench
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=workbench
AWS_ENDPOINT=http://stub:8080
AWS_USE_PATH_STYLE_ENDPOINT=true
VAPID_PUBLIC_KEY=             # test pair in docker/compose.yml
VAPID_PRIVATE_KEY=
